{
    "name": "ho-nl/template-mageos",
    "description": "Deployyy template project — Mage-OS Open Source with sample data, ready to build and deploy",
    "type": "project",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "mage-os/*": true,
            "php-http/discovery": true,
            "vaimo/composer-patches": true
        },
        "platform": {
            "php": "8.4.0"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.mage-os.org/"
        }
    ],
    "require": {
        "mage-os/composer-dependency-version-audit-plugin": "^3.5",
        "mage-os/composer-root-update-plugin": "^3.5",
        "mage-os/module-bundle-sample-data": "^3.5",
        "mage-os/module-catalog-rule-sample-data": "^3.5",
        "mage-os/module-catalog-sample-data": "^3.5",
        "mage-os/module-cms-sample-data": "^3.5",
        "mage-os/module-configurable-sample-data": "^3.5",
        "mage-os/module-customer-sample-data": "^3.5",
        "mage-os/module-downloadable-sample-data": "^3.5",
        "mage-os/module-grouped-product-sample-data": "^3.5",
        "mage-os/module-msrp-sample-data": "^3.5",
        "mage-os/module-offline-shipping-sample-data": "^3.5",
        "mage-os/module-product-links-sample-data": "^3.5",
        "mage-os/module-review-sample-data": "^3.5",
        "mage-os/module-sales-rule-sample-data": "^3.5",
        "mage-os/module-sales-sample-data": "^3.5",
        "mage-os/module-swatches-sample-data": "^3.5",
        "mage-os/module-tax-sample-data": "^3.5",
        "mage-os/module-theme-sample-data": "^3.5",
        "mage-os/module-widget-sample-data": "^3.5",
        "mage-os/module-wishlist-sample-data": "^3.5",
        "mage-os/product-community-edition": "^3.5",
        "mage-os/sample-data-media": "^3.5",
        "vaimo/composer-patches": "^6.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7 || ^1.0",
        "mage-os/magento-coding-standard": "^3.5",
        "phpstan/phpstan": "^1.9",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Magento\\Framework\\": "lib/internal/Magento/Framework/",
            "Magento\\Setup\\": "setup/src/Magento/Setup/",
            "Magento\\": "app/code/Magento/",
            "MageOS\\Installer\\": "setup/src/MageOS/Installer/"
        },
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/Fixture/**",
            "**/Test/Integration/**",
            "**/Test/Mftf/**",
            "**/Test/Unit/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\PhpStan\\": "dev/tests/static/framework/Magento/PhpStan/",
            "MageOS\\Installer\\Test\\": "setup/tests/"
        }
    },
    "extra": {
        "magento-force": "override",
        "patches": {}
    },
    "prefer-stable": true,
    "minimum-stability": "stable"
}
